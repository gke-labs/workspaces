# Fast Layer Dockerfile for Custom Kubeflow Code-Server Python Image (TPU) with Gemini Code Assist
# Extends upstream ghcr.io/kubeflow/kubeflow/notebook-servers/codeserver-python:v1.11.0
#

ARG BASE_IMG=ghcr.io/kubeflow/kubeflow/notebook-servers/codeserver-python:v1.11.0
FROM $BASE_IMG

ARG TARGETARCH=amd64

# Extension version (from Open VSX)
ARG GEMINICODEASSIST_VERSION=2.100.0

# Install Node.js & Gemini CLI
USER root
ARG NODE_VERSION=22.14.0
RUN case "${TARGETARCH}" in \
      amd64) NODE_ARCH="x64" ;; \
      arm64) NODE_ARCH="arm64" ;; \
      *) echo "Unsupported architecture: ${TARGETARCH}"; exit 1 ;; \
    esac \
 && curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${NODE_ARCH}.tar.xz" | tar -xJ -C /usr/local --strip-components=1 \
 && npm install -g @google/gemini-cli@nightly \
 && gemini --version

USER $NB_UID

ENV PATH="${HOME}/.local/bin:${PATH}"

# Configure Conda to persist environments and package caches on the persistent home volume (~/.conda)
RUN conda config --system --prepend envs_dirs '~/.conda/envs' \
 && conda config --system --prepend pkgs_dirs '~/.conda/pkgs'

# Install additional Python requirements for TPU (including jax[tpu] and libtpu)
COPY --chown=${NB_USER}:${NB_GID} requirements-tpu.txt /tmp/requirements.txt
RUN PIP_NO_CACHE_DIR=off python3 -m pip install -r /tmp/requirements.txt --quiet --no-cache-dir \
 && rm -f /tmp/requirements.txt

# Optional: Install torch_tpu (PyTorch backend for Cloud TPU)
# NOTE: Users must have access to https://github.com/google-pytorch/torch_tpu to install this package.
# Enabled by passing --build-arg INSTALL_TORCH_TPU=true and --build-arg TORCH_TPU_TOKEN=$(gcloud auth application-default print-access-token)
ARG INSTALL_TORCH_TPU=false
ARG TORCH_TPU_TOKEN=""
ARG TORCH_TPU_ACCESS_TOKEN=""
RUN TOKEN="${TORCH_TPU_TOKEN:-${TORCH_TPU_ACCESS_TOKEN}}"; \
    TOKEN="$(echo "${TOKEN}" | tr -d '[:space:]')"; \
    if [ "${INSTALL_TORCH_TPU}" = "true" ] || [ -n "${TOKEN}" ]; then \
      if [ -z "${TOKEN}" ]; then \
        TOKEN="$(gcloud auth application-default print-access-token 2>/dev/null || gcloud auth print-access-token 2>/dev/null || true)"; \
        TOKEN="$(echo "${TOKEN}" | tr -d '[:space:]')"; \
      fi; \
      if [ -n "${TOKEN}" ]; then \
        echo "Installing torch_tpu from virtual registry..."; \
        if ! PIP_NO_CACHE_DIR=off python3 -m pip install --pre --index-url "https://oauth2accesstoken:${TOKEN}@us-python.pkg.dev/ml-oss-artifacts-transient/torch-tpu-virtual-registry/simple/" torch_tpu --quiet --no-cache-dir; then \
          echo "WARNING: Failed to install torch_tpu. Access to https://github.com/google-pytorch/torch_tpu is required to download torch_tpu wheels. Continuing build without torch_tpu." >&2; \
        fi; \
      else \
        echo "WARNING: No access token provided for torch_tpu. Access to https://github.com/google-pytorch/torch_tpu is required. Pass --build-arg TORCH_TPU_TOKEN=\$(gcloud auth application-default print-access-token)." >&2; \
      fi; \
    else \
      echo "Skipping torch_tpu installation (INSTALL_TORCH_TPU=false and no token provided)"; \
    fi \
 && pip config --site set install.user true

# Install additional VS Code extensions (Gemini Code Assist, Marimo)
# NOTE: XDG_DATA_HOME in Kubeflow codeserver is set to /tmp/data-${NB_USER} (non-PVC)
RUN code-server --install-extension "Google.geminicodeassist@${GEMINICODEASSIST_VERSION}" --force \
 && code-server --install-extension "marimo-team.vscode-marimo" --force \
 && code-server --list-extensions --show-versions

# Pre-populate home with samples, and sync to $HOME_TMP for s6 01-copy-tmp-home
COPY --chown=${NB_USER}:${NB_GID} samples/. ${HOME}/samples/
RUN cp -p -r -T "${HOME}" "${HOME_TMP}" \
 && chmod -R g=u "${HOME_TMP}"
