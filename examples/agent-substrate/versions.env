# Pinned versions for examples/agent-substrate. Both projects are pre-1.0 and
# make no API compatibility promises, so the example is tested against exactly
# these. Override any of them by exporting it before running the scripts.

# Agent Substrate release. When empty, images are built from source via ko
# to KO_DOCKER_REPO (${REGISTRY}/substrate).
SUBSTRATE_REPO="${SUBSTRATE_REPO:-https://github.com/agent-substrate/substrate.git}"
SUBSTRATE_VERSION="${SUBSTRATE_VERSION:-v0.5.0}"
ATE_IMAGE_REPO="${ATE_IMAGE_REPO:-}"

# AX, built from source: this branch tracks Substrate v0.5.0.
if [[ -d "/usr/local/google/home/sizhang/Projects/agents-projects/ax" ]]; then
  AX_REPO="${AX_REPO:-/usr/local/google/home/sizhang/Projects/agents-projects/ax}"
else
  AX_REPO="${AX_REPO:-https://github.com/siyuanfoundation/ax.git}"
fi
AX_REF="${AX_REF:-bump}"
