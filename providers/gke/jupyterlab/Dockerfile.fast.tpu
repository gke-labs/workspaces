#
# Fast Layer Dockerfile for Custom Kubeflow JupyterLab Image (TPU)
# Extends upstream ghcr.io/kubeflow/kubeflow/notebook-servers/jupyter-scipy:v1.11.0
#

# Pinned by digest, not just by tag. Upstream republishes v1.11.0 in place, and this
# image is the evidence: it was built from this tag and carries pandas 2.2.3 /
# matplotlib 3.10.0 / scipy 1.15.1, while the same tag today resolves to pandas 3.0.3 /
# matplotlib 3.10.9 / scipy 1.17.1. The tag is kept alongside the digest for
# readability only -- Docker resolves the digest and ignores it.
#
# NOTE: unlike the CPU variant, pinning here is NOT a no-op. The deployed TPU image
# predates this digest, so the next TPU build moves forward onto a newer base. It is
# the same base the CPU image already runs without trouble, but the TPU stack has not
# been rebuilt against it -- jax 0.10.2 and libtpu 0.0.42.1 are version-locked to each
# other, so run a real TPU workload after the first rebuild.
#
# To move up, pull the new tag, rebuild, run a TPU workload, and update the digest:
#   docker buildx imagetools inspect \
#     ghcr.io/kubeflow/kubeflow/notebook-servers/jupyter-scipy:v1.11.0
ARG BASE_IMG=ghcr.io/kubeflow/kubeflow/notebook-servers/jupyter-scipy:v1.11.0@sha256:8f8a000b7eece82c7e874924dc45a3922e9197137eefe67f55c711cc3ce068fd
FROM $BASE_IMG

ARG TARGETARCH=amd64

USER $NB_UID

ENV PATH="${HOME}/.local/bin:${PATH}"

# Configure Conda to persist environments and package caches on the persistent home volume (~/.conda)
RUN conda config --system --prepend envs_dirs '~/.conda/envs' \
 && conda config --system --prepend pkgs_dirs '~/.conda/pkgs'

# Install additional Python requirements for TPU (including jax[tpu], libtpu, kubeflow[spark], google-cloud-storage)
COPY --chown=${NB_USER}:${NB_GID} requirements-tpu.txt /tmp/requirements.txt
RUN PIP_NO_CACHE_DIR=off python3 -m pip install -r /tmp/requirements.txt --quiet --no-cache-dir \
 && rm -f /tmp/requirements.txt \
 && pip config --site set install.user true

# Pre-populate home with custom README and examples, and sync to $HOME_TMP for s6 01-copy-tmp-home
COPY --chown=${NB_USER}:${NB_GID} home/. ${HOME}/
COPY --chown=${NB_USER}:${NB_GID} examples/. ${HOME}/
RUN cp -p -r -T "${HOME}" "${HOME_TMP}" \
 && chmod -R g=u "${HOME_TMP}"
